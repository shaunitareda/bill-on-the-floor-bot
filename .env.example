# Congress.gov API key
CONGRESS_API_KEY=your_congress_api_key

# Bluesky / AT Protocol account
BLUESKY_HANDLE=your.handle.example
BLUESKY_APP_PASSWORD=your_app_password

# Optional: force a specific ATProto PDS endpoint.
# Leave unset to resolve the account's PDS automatically from its DID document.
# ATPROTO_SERVICE=https://example-pds.invalid
